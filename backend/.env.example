# Unpolish server config — works for BOTH local and Vercel deploy.
#
# Authentication paths:
#   Local server: leave ANTHROPIC_API_KEY unset; the Claude Agent SDK uses
#     your Claude Code login automatically (Pro / Max). Run `claude` once
#     on this machine first to authenticate.
#   Vercel deploy: set ANTHROPIC_API_KEY (your personal Anthropic API key).
#     Vercel can't run Claude Code, so it goes through the API.

# Set this on Vercel (and locally if you want to use API instead of subscription).
# ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED on both the local server and the Vercel deploy. Both refuse to
# serve requests without it.
# Generate with:  openssl rand -hex 32
# SHARED_SECRET=any-random-string

# Optional. Default model.
# MODEL=claude-haiku-4-5-20251001

# Optional. Default port for the local server.
# PORT=3939
