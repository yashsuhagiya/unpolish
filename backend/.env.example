# Unpolish server config, used by both the local server and the Vercel deploy.
# The local server reads it from backend/.env.local.

# Your Anthropic API key. Needed for the Vercel deploy and the local server.
# ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED on both the local server and the Vercel deploy. Both refuse to
# serve requests without it.
# Generate with:  openssl rand -hex 32
# SHARED_SECRET=any-random-string

# Optional. Default model.
# MODEL=claude-haiku-4-5-20251001

# Optional. Default port for the local server.
# PORT=3939
